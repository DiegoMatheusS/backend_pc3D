# PostgreSQL
DATABASE_URL="postgresql://pcbuilder_app:TROQUE_A_SENHA@localhost:5432/pc_builder?schema=public"

# Aplicação
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Sessão
SESSION_COOKIE_NAME=pcbuilder_session
SESSION_DURATION_HOURS=8

# Swagger
SWAGGER_ENABLED=true

# IA (configurar apenas quando a etapa de IA for ativada)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
