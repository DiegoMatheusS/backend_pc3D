# PostgreSQL
DATABASE_URL="postgresql://pcbuilder_app:TROQUE_A_SENHA@localhost:5432/pc_builder?schema=public"

# Aplicação
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Sessão
SESSION_COOKIE_NAME=pcbuilder_session
SESSION_DURATION_HOURS=8

# Swagger
SWAGGER_ENABLED=true

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ProjetoIA — serviço interno usado para descoberta/enriquecimento e Shopee.
# O backend NÃO recebe o Secret da Shopee; ele fica somente no ProjetoIA.
PRODUTO_IA_URL=http://localhost:8000
PRODUTO_IA_API_KEY=
PRODUTO_IA_TIMEOUT_MS=120000
PRODUTO_IA_SHOPEE_TIMEOUT_MS=30000

# Cloudflare R2 — modelos 3D GLB
# Endpoint S3 da conta, SEM o nome do bucket no final.
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=criabyte-modelos-3d
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL pública r2.dev por enquanto; futuramente pode ser um domínio próprio.
R2_PUBLIC_URL=https://pub-SEU_ID.r2.dev
