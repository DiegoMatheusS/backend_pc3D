NODE_ENV=development
PORT=3000
SESSION_COOKIE_NAME=pcbuilder_session
SESSION_DURATION_HOURS=8
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO?schema=public"

# Origins permitidas pelo CORS (separadas por vírgula)
# Em producao, informe a URL exata do frontend, ex: https://pcbuilder.com.br
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chave da API de Inteligencia Artificial (Google Gemini)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Em produção, o Swagger fica desabilitado por padrão. Defina true apenas se necessário.
SWAGGER_ENABLED=false
