  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("especificacoes_teclados")
}

model EspecificacaoHeadset {
  id           Int     @id @default(autoincrement())
  produtoId    Int     @unique @map("produto_id")
  tipoConexao  String? @map("tipo_conexao") @db.VarChar(100)
  wireless     Boolean @default(false)
  bluetooth    Boolean @default(false)
  driverMm     Float?  @map("driver_mm")
  microfone    Boolean @default(true)
  somSurround  Boolean @default(false) @map("som_surround")
  impedancia   Float?
