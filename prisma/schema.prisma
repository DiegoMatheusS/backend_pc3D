  conectoresSata          Int               @default(0) @map("conectores_sata")
  conectoresMolex         Int               @default(0) @map("conectores_molex")
  protecoes               String[]          @default([])
  tensaoEntrada           String?           @map("tensao_entrada") @db.VarChar(100)

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

