generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMIN
  EDITOR
  REVISOR
  USUARIO
}

enum CategoriaHardware {
  PROCESSADOR
  COOLER
  PLACA_MAE
  MEMORIA_RAM
  PLACA_VIDEO
  ARMAZENAMENTO
  FONTE
  GABINETE
  VENTOINHA
  MONITOR
  MOUSE
  TECLADO
  FONE
  MICROFONE
}

enum TipoMemoria {
  DDR3
  DDR4
  DDR5
}

enum FormatoMemoria {
  DIMM
  SO_DIMM
}

enum FormatoPlacaMae {
  E_ATX
  ATX
  MICRO_ATX
  MINI_ITX
}

enum TamanhoGabinete {
  FULL_TOWER
  MID_TOWER
  MINI_TOWER
  SFF
  OPEN_FRAME
}

enum FormatoFonte {
  ATX
  SFX
  SFX_L
  TFX
  FLEX_ATX
}

enum PosicaoRefrigeracaoGabinete {
  FRENTE
  TOPO
  TRASEIRA
  INFERIOR
  LATERAL
}

enum ModularidadeFonte {
  NAO_MODULAR
  SEMI_MODULAR
  MODULAR
}

enum TipoCooler {
  AIR_COOLER
  WATER_COOLER
}

enum TipoConectorVentoinha {
  DC_3_PINOS
  PWM_4_PINOS
  MOLEX
  PROPRIETARIO
}

enum TipoArmazenamento {
  SSD
  HDD
}

enum FormatoArmazenamento {
  POLEGADAS_2_5
  POLEGADAS_3_5
  M2
  PLACA_PCIE
}

enum InterfaceArmazenamento {
  SATA
  NVME_PCIE
  SAS
}

enum ChaveM2 {
  B
  M
  B_M
}

enum FormatoModelo3D {
  GLB
  GLTF
  FBX
  OBJ
}

enum TipoFonteImportacao {
  API
  HTML_OFICIAL
  PDF_OFICIAL
  CSV
  FEED
  MANUAL
}

enum StatusImportacao {
  PENDENTE
  PROCESSANDO
  AGUARDANDO_REVISAO
  APROVADA
  REJEITADA
  FALHOU
}

model Usuario {
  id                   Int                  @id @default(autoincrement())
  nome                 String               @db.VarChar(150)
  email                String               @unique @db.VarChar(255)
  senhaHash            String               @map("senha_hash") @db.VarChar(255)
  papel                PapelUsuario         @default(USUARIO)
  ativo                Boolean              @default(true)
  criadoEm             DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  importacoesRevisadas ImportacaoHardware[] @relation("ImportacoesRevisadas")

  sessoes Sessao[]

  @@map("usuarios")
}

model Sessao {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadaEm DateTime? @map("revogada_em") @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

model Hardware {
  id                         Int                         @id @default(autoincrement())
  nome                       String                      @db.VarChar(200)
  slug                       String                      @unique @db.VarChar(220)
  categoria                  CategoriaHardware
  marca                      String                      @db.VarChar(100)
  modelo                     String                      @db.VarChar(150)
  descricao                  String?                     @db.Text
  imagemUrl                  String?                     @map("imagem_url") @db.VarChar(500)
  especificacoes             Json?
  publicado                  Boolean                     @default(false)
  ativo                      Boolean                     @default(true)
  criadoEm                   DateTime                    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm               DateTime                    @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  especificacaoProcessador   EspecificacaoProcessador?
  especificacaoPlacaMae      EspecificacaoPlacaMae?
  especificacaoMemoriaRam    EspecificacaoMemoriaRam?
  especificacaoGabinete      EspecificacaoGabinete?
  especificacaoFonte         EspecificacaoFonte?
  especificacaoPlacaVideo    EspecificacaoPlacaVideo?
  especificacaoCooler        EspecificacaoCooler?
  especificacaoVentoinha     EspecificacaoVentoinha?
  especificacaoArmazenamento EspecificacaoArmazenamento?
  modelos3D                  Modelo3DHardware[]
  pontosEncaixe              PontoEncaixeHardware[]
  ajustesComoHardwareFilho   AjusteEncaixeHardware[]
  importacoes                ImportacaoHardware[]

  compatibilidadesComoPlacaMae CompatibilidadeCpuPlacaMae[] @relation("PlacaMaeCpuCompatibilidade")

  compatibilidadesComoProcessador CompatibilidadeCpuPlacaMae[] @relation("ProcessadorPlacaMaeCompatibilidade")

  compatibilidadesComoPlacaMaeRam CompatibilidadeMemoriaPlacaMae[] @relation("PlacaMaeMemoriaCompatibilidade")

  compatibilidadesComoMemoriaRam CompatibilidadeMemoriaPlacaMae[] @relation("MemoriaPlacaMaeCompatibilidade")

  @@index([categoria])
  @@index([marca])
  @@index([ativo, publicado])
  @@map("hardwares")
}

model EspecificacaoProcessador {
  id                         Int           @id @default(autoincrement())
  hardwareId                 Int           @unique @map("hardware_id")
  socket                     String        @db.VarChar(50)
  familia                    String?       @db.VarChar(100)
  linha                      String?       @db.VarChar(100)
  geracao                    String?       @db.VarChar(100)
  arquitetura                String?       @db.VarChar(100)
  nucleos                    Int?
  threads                    Int?
  frequenciaBaseMhz          Int?          @map("frequencia_base_mhz")
  frequenciaTurboMhz         Int?          @map("frequencia_turbo_mhz")
  tdpWatts                   Int?          @map("tdp_watts")
  possuiVideoIntegrado       Boolean       @default(false) @map("possui_video_integrado")
  modeloVideoIntegrado       String?       @map("modelo_video_integrado") @db.VarChar(150)
  tiposMemoriaSuportados     TipoMemoria[] @map("tipos_memoria_suportados")
  frequenciaMemoriaMaximaMhz Int?          @map("frequencia_memoria_maxima_mhz")
  capacidadeMemoriaMaximaGb  Int?          @map("capacidade_memoria_maxima_gb")
  canaisMemoria              Int?          @map("canais_memoria")
  suportaEcc                 Boolean       @default(false) @map("suporta_ecc")

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_processadores")
}

model EspecificacaoPlacaMae {
  id                             Int             @id @default(autoincrement())
  hardwareId                     Int             @unique @map("hardware_id")
  socket                         String          @db.VarChar(50)
  chipset                        String          @db.VarChar(100)
  formato                        FormatoPlacaMae
  revisao                        String?         @db.VarChar(50)
  biosInicial                    String?         @map("bios_inicial") @db.VarChar(50)
  tiposMemoriaSuportados         TipoMemoria[]   @map("tipos_memoria_suportados")
  frequenciasMemoriaJedecMhz     Int[]           @map("frequencias_memoria_jedec_mhz")
  frequenciasMemoriaOverclockMhz Int[]           @map("frequencias_memoria_overclock_mhz")
  slotsMemoria                   Int             @map("slots_memoria")
  capacidadeMaximaMemoriaGb      Int?            @map("capacidade_maxima_memoria_gb")
  capacidadeMaximaPorSlotGb      Int?            @map("capacidade_maxima_por_slot_gb")
  suportaXmp                     Boolean         @default(false) @map("suporta_xmp")
  suportaExpo                    Boolean         @default(false) @map("suporta_expo")
  suportaEcc                     Boolean         @default(false) @map("suporta_ecc")
  saidasVideo                    String[]        @map("saidas_video")
  portasSata                     Int             @default(0) @map("portas_sata")

  slotsM2  SlotM2PlacaMae[]
  hardware Hardware         @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_placas_mae")
}

model EspecificacaoMemoriaRam {
  id                    Int            @id @default(autoincrement())
  hardwareId            Int            @unique @map("hardware_id")
  tipo                  TipoMemoria
  formato               FormatoMemoria
  capacidadePorModuloGb Int            @map("capacidade_por_modulo_gb")
  quantidadeModulos     Int            @default(1) @map("quantidade_modulos")
  frequenciaMhz         Int            @map("frequencia_mhz")
  frequenciaJedecMhz    Int?           @map("frequencia_jedec_mhz")
  latenciaCl            Int?           @map("latencia_cl")
  tensaoVolts           Float?         @map("tensao_volts")
  ecc                   Boolean        @default(false)
  registrada            Boolean        @default(false)
  suportaXmp            Boolean        @default(false) @map("suporta_xmp")
  suportaExpo           Boolean        @default(false) @map("suporta_expo")
  alturaMm              Float?         @map("altura_mm")

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_memorias_ram")
}

model EspecificacaoGabinete {
  id                         Int               @id @default(autoincrement())
  hardwareId                 Int               @unique @map("hardware_id")
  tamanho                    TamanhoGabinete
  alturaMm                   Float             @map("altura_mm")
  larguraMm                  Float             @map("largura_mm")
  profundidadeMm             Float             @map("profundidade_mm")
  formatosPlacaMaeSuportados FormatoPlacaMae[] @map("formatos_placa_mae_suportados")
  formatosFonteSuportados    FormatoFonte[]    @map("formatos_fonte_suportados")
  comprimentoMaximoFonteMm   Float?            @map("comprimento_maximo_fonte_mm")
  comprimentoMaximoGpuMm     Float?            @map("comprimento_maximo_gpu_mm")
  alturaMaximaGpuMm          Float?            @map("altura_maxima_gpu_mm")
  slotsMaximosGpu            Float?            @map("slots_maximos_gpu")
  alturaMaximaCoolerCpuMm    Float?            @map("altura_maxima_cooler_cpu_mm")
  baias25                    Int               @default(0) @map("baias_25")
  baias35                    Int               @default(0) @map("baias_35")
  slotsTraseiros             Int?              @map("slots_traseiros")
  suportaGpuVertical         Boolean           @default(false) @map("suporta_gpu_vertical")
  espacoGerenciamentoCabosMm Float?            @map("espaco_gerenciamento_cabos_mm")

  hardware         Hardware                   @relation(fields: [hardwareId], references: [id], onDelete: Cascade)
  suportesFans     SuporteVentoinhaGabinete[]
  suportesRadiador SuporteRadiadorGabinete[]

  @@map("especificacoes_gabinetes")
}

model EspecificacaoFonte {
  id                      Int               @id @default(autoincrement())
  hardwareId              Int               @unique @map("hardware_id")
  formato                 FormatoFonte
  potenciaWatts           Int               @map("potencia_watts")
  certificacao            String?           @db.VarChar(100)
  modularidade            ModularidadeFonte @default(NAO_MODULAR)
  comprimentoMm           Float?            @map("comprimento_mm")
  larguraMm               Float?            @map("largura_mm")
  alturaMm                Float?            @map("altura_mm")
  padraoAtx               String?           @map("padrao_atx") @db.VarChar(50)
  eficienciaPercentual    Float?            @map("eficiencia_percentual")
  correnteLinha12vAmperes Float?            @map("corrente_linha_12v_amperes")
  conectoresAtx24Pinos    Int               @default(1) @map("conectores_atx_24_pinos")
  conectoresEpsCpu        Int               @default(1) @map("conectores_eps_cpu")
  conectoresPcie6Pinos    Int               @default(0) @map("conectores_pcie_6_pinos")
  conectoresPcie8Pinos    Int               @default(0) @map("conectores_pcie_8_pinos")
  conectores12vhpwr       Int               @default(0) @map("conectores_12vhpwr")
  conectores12v2x6        Int               @default(0) @map("conectores_12v_2x6")
  conectoresSata          Int               @default(0) @map("conectores_sata")
  conectoresMolex         Int               @default(0) @map("conectores_molex")
  protecoes               String[]          @default([])
  tensaoEntrada           String?           @map("tensao_entrada") @db.VarChar(100)

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_fontes")
}

model EspecificacaoPlacaVideo {
  id                            Int      @id @default(autoincrement())
  hardwareId                    Int      @unique @map("hardware_id")
  chipset                       String?  @db.VarChar(150)
  memoriaVideoGb                Int?     @map("memoria_video_gb")
  tipoMemoriaVideo              String?  @map("tipo_memoria_video") @db.VarChar(50)
  geracaoPcie                   Int?     @map("geracao_pcie")
  larguraPcie                   Int?     @map("largura_pcie")
  comprimentoMm                 Float    @map("comprimento_mm")
  alturaMm                      Float?   @map("altura_mm")
  espessuraMm                   Float?   @map("espessura_mm")
  slotsOcupados                 Float?   @map("slots_ocupados")
  consumoWatts                  Int?     @map("consumo_watts")
  potenciaFonteRecomendadaWatts Int?     @map("potencia_fonte_recomendada_watts")
  conectoresPcie6Pinos          Int      @default(0) @map("conectores_pcie_6_pinos")
  conectoresPcie8Pinos          Int      @default(0) @map("conectores_pcie_8_pinos")
  conectores12vhpwr             Int      @default(0) @map("conectores_12vhpwr")
  conectores12v2x6              Int      @default(0) @map("conectores_12v_2x6")
  saidasVideo                   String[] @default([]) @map("saidas_video")

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_placas_video")
}

model EspecificacaoCooler {
  id                      Int        @id @default(autoincrement())
  hardwareId              Int        @unique @map("hardware_id")
  tipo                    TipoCooler
  socketsSuportados       String[]   @default([]) @map("sockets_suportados")
  capacidadeTermicaWatts  Int?       @map("capacidade_termica_watts")
  alturaMm                Float?     @map("altura_mm")
  larguraMm               Float?     @map("largura_mm")
  profundidadeMm          Float?     @map("profundidade_mm")
  alturaLivreRamMm        Float?     @map("altura_livre_ram_mm")
  tamanhoRadiadorMm       Int?       @map("tamanho_radiador_mm")
  espessuraRadiadorMm     Float?     @map("espessura_radiador_mm")
  quantidadeVentoinhas    Int?       @map("quantidade_ventoinhas")
  tamanhoVentoinhaMm      Int?       @map("tamanho_ventoinha_mm")
  espessuraVentoinhaMm    Float?     @map("espessura_ventoinha_mm")
  comprimentoMangueirasMm Float?     @map("comprimento_mangueiras_mm")
  conectorBomba           String?    @map("conector_bomba") @db.VarChar(50)
  consumoBombaWatts       Float?     @map("consumo_bomba_watts")
  rgb                     Boolean    @default(false)
  argb                    Boolean    @default(false)

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_coolers")
}

model EspecificacaoVentoinha {
  id                   Int                   @id @default(autoincrement())
  hardwareId           Int                   @unique @map("hardware_id")
  tamanhoMm            Int                   @map("tamanho_mm")
  espessuraMm          Float?                @map("espessura_mm")
  rpmMinima            Int?                  @map("rpm_minima")
  rpmMaxima            Int?                  @map("rpm_maxima")
  fluxoArCfm           Float?                @map("fluxo_ar_cfm")
  pressaoEstaticaMmH2o Float?                @map("pressao_estatica_mm_h2o")
  ruidoDb              Float?                @map("ruido_db")
  conector             TipoConectorVentoinha
  tensaoVolts          Float?                @map("tensao_volts")
  correnteAmperes      Float?                @map("corrente_amperes")
  pwm                  Boolean               @default(false)
  rgb                  Boolean               @default(false)
  argb                 Boolean               @default(false)
  fluxoReverso         Boolean               @default(false) @map("fluxo_reverso")

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_ventoinhas")
}

model EspecificacaoArmazenamento {
  id                    Int                    @id @default(autoincrement())
  hardwareId            Int                    @unique @map("hardware_id")
  tipo                  TipoArmazenamento
  formato               FormatoArmazenamento
  interface             InterfaceArmazenamento
  capacidadeGb          Int                    @map("capacidade_gb")
  tamanhoM2Mm           Int?                   @map("tamanho_m2_mm")
  chaveM2               ChaveM2?               @map("chave_m2")
  geracaoPcie           Int?                   @map("geracao_pcie")
  pistasPcie            Int?                   @map("pistas_pcie")
  leituraSequencialMbps Int?                   @map("leitura_sequencial_mbps")
  escritaSequencialMbps Int?                   @map("escrita_sequencial_mbps")
  alturaMm              Float?                 @map("altura_mm")
  larguraMm             Float?                 @map("largura_mm")
  profundidadeMm        Float?                 @map("profundidade_mm")
  espessuraMm           Float?                 @map("espessura_mm")
  consumoWatts          Float?                 @map("consumo_watts")
  possuiDissipador      Boolean                @default(false) @map("possui_dissipador")

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_armazenamentos")
}

model SuporteVentoinhaGabinete {
  id                      Int                         @id @default(autoincrement())
  especificacaoGabineteId Int                         @map("especificacao_gabinete_id")
  posicao                 PosicaoRefrigeracaoGabinete
  tamanhoMm               Int                         @map("tamanho_mm")
  quantidadeMaxima        Int                         @map("quantidade_maxima")
  espessuraMaximaMm       Float?                      @map("espessura_maxima_mm")
  observacao              String?                     @db.Text

  especificacaoGabinete EspecificacaoGabinete @relation(fields: [especificacaoGabineteId], references: [id], onDelete: Cascade)

  @@unique([especificacaoGabineteId, posicao, tamanhoMm])
  @@map("suportes_ventoinhas_gabinetes")
}

model SuporteRadiadorGabinete {
  id                        Int                         @id @default(autoincrement())
  especificacaoGabineteId   Int                         @map("especificacao_gabinete_id")
  posicao                   PosicaoRefrigeracaoGabinete
  tamanhoMm                 Int                         @map("tamanho_mm")
  espessuraConjuntoMaximaMm Float?                      @map("espessura_conjunto_maxima_mm")
  observacao                String?                     @db.Text

  especificacaoGabinete EspecificacaoGabinete @relation(fields: [especificacaoGabineteId], references: [id], onDelete: Cascade)

  @@unique([especificacaoGabineteId, posicao, tamanhoMm])
  @@map("suportes_radiadores_gabinetes")
}

model CompatibilidadeCpuPlacaMae {
  id              Int       @id @default(autoincrement())
  placaMaeId      Int       @map("placa_mae_id")
  processadorId   Int       @map("processador_id")
  revisaoPlacaMae String?   @map("revisao_placa_mae") @db.VarChar(50)
  biosMinima      String?   @map("bios_minima") @db.VarChar(50)
  compativel      Boolean   @default(true)
  observacao      String?   @db.Text
  fonteUrl        String?   @map("fonte_url") @db.VarChar(500)
  verificadoEm    DateTime? @map("verificado_em") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  placaMae Hardware @relation("PlacaMaeCpuCompatibilidade", fields: [placaMaeId], references: [id], onDelete: Cascade)

  processador Hardware @relation("ProcessadorPlacaMaeCompatibilidade", fields: [processadorId], references: [id], onDelete: Cascade)

  @@unique([placaMaeId, processadorId, revisaoPlacaMae])
  @@index([placaMaeId])
  @@index([processadorId])
  @@map("compatibilidades_cpu_placa_mae")
}

model Modelo3DHardware {
  id                 Int             @id @default(autoincrement())
  hardwareId         Int             @map("hardware_id")
  nome               String?         @db.VarChar(150)
  arquivoUrl         String          @map("arquivo_url") @db.VarChar(500)
  formato            FormatoModelo3D
  versao             String?         @db.VarChar(50)
  alturaRealMm       Float?          @map("altura_real_mm")
  larguraRealMm      Float?          @map("largura_real_mm")
  profundidadeRealMm Float?          @map("profundidade_real_mm")
  posicaoCorrecaoX   Float           @default(0) @map("posicao_correcao_x")
  posicaoCorrecaoY   Float           @default(0) @map("posicao_correcao_y")
  posicaoCorrecaoZ   Float           @default(0) @map("posicao_correcao_z")
  rotacaoCorrecaoX   Float           @default(0) @map("rotacao_correcao_x")
  rotacaoCorrecaoY   Float           @default(0) @map("rotacao_correcao_y")
  rotacaoCorrecaoZ   Float           @default(0) @map("rotacao_correcao_z")
  escalaCorrecaoX    Float           @default(1) @map("escala_correcao_x")
  escalaCorrecaoY    Float           @default(1) @map("escala_correcao_y")
  escalaCorrecaoZ    Float           @default(1) @map("escala_correcao_z")
  ativo              Boolean         @default(true)
  aprovado           Boolean         @default(false)
  criadoEm           DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@index([hardwareId])
  @@index([hardwareId, ativo])
  @@map("modelos_3d_hardwares")
}

model PontoEncaixeHardware {
  id                 Int                     @id @default(autoincrement())
  hardwarePaiId      Int                     @map("hardware_pai_id")
  codigo             String                  @db.VarChar(100)
  nome               String?                 @db.VarChar(150)
  categoriaAceita    CategoriaHardware       @map("categoria_aceita")
  posicaoX           Float                   @default(0) @map("posicao_x")
  posicaoY           Float                   @default(0) @map("posicao_y")
  posicaoZ           Float                   @default(0) @map("posicao_z")
  rotacaoX           Float                   @default(0) @map("rotacao_x")
  rotacaoY           Float                   @default(0) @map("rotacao_y")
  rotacaoZ           Float                   @default(0) @map("rotacao_z")
  escalaX            Float                   @default(1) @map("escala_x")
  escalaY            Float                   @default(1) @map("escala_y")
  escalaZ            Float                   @default(1) @map("escala_z")
  ordem              Int                     @default(0)
  obrigatorio        Boolean                 @default(false)
  ativo              Boolean                 @default(true)
  observacao         String?                 @db.Text
  criadoEm           DateTime                @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime                @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  ajustesEspecificos AjusteEncaixeHardware[]

  hardwarePai Hardware @relation(fields: [hardwarePaiId], references: [id], onDelete: Cascade)

  @@unique([hardwarePaiId, codigo])
  @@index([hardwarePaiId, categoriaAceita])
  @@map("pontos_encaixe_hardwares")
}

model AjusteEncaixeHardware {
  id              Int      @id @default(autoincrement())
  pontoEncaixeId  Int      @map("ponto_encaixe_id")
  hardwareFilhoId Int      @map("hardware_filho_id")
  posicaoX        Float    @default(0) @map("posicao_x")
  posicaoY        Float    @default(0) @map("posicao_y")
  posicaoZ        Float    @default(0) @map("posicao_z")
  rotacaoX        Float    @default(0) @map("rotacao_x")
  rotacaoY        Float    @default(0) @map("rotacao_y")
  rotacaoZ        Float    @default(0) @map("rotacao_z")
  escalaX         Float    @default(1) @map("escala_x")
  escalaY         Float    @default(1) @map("escala_y")
  escalaZ         Float    @default(1) @map("escala_z")
  observacao      String?  @db.Text
  revisado        Boolean  @default(false)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  pontoEncaixe  PontoEncaixeHardware @relation(fields: [pontoEncaixeId], references: [id], onDelete: Cascade)
  hardwareFilho Hardware             @relation(fields: [hardwareFilhoId], references: [id], onDelete: Cascade)

  @@unique([pontoEncaixeId, hardwareFilhoId])
  @@index([hardwareFilhoId])
  @@map("ajustes_encaixes_hardwares")
}

model CompatibilidadeMemoriaPlacaMae {
  id                        Int       @id @default(autoincrement())
  placaMaeId                Int       @map("placa_mae_id")
  memoriaRamId              Int       @map("memoria_ram_id")
  revisaoPlacaMae           String?   @map("revisao_placa_mae") @db.VarChar(50)
  biosTestada               String?   @map("bios_testada") @db.VarChar(50)
  familiaProcessadorTestada String?   @map("familia_processador_testada") @db.VarChar(150)
  frequenciaValidadaMhz     Int?      @map("frequencia_validada_mhz")
  quantidadeModulosTestados Int?      @map("quantidade_modulos_testados")
  capacidadeTotalTestadaGb  Int?      @map("capacidade_total_testada_gb")
  compativel                Boolean   @default(true)
  constaNaQvl               Boolean   @default(true) @map("consta_na_qvl")
  observacao                String?   @db.Text
  fonteUrl                  String?   @map("fonte_url") @db.VarChar(500)
  verificadoEm              DateTime? @map("verificado_em") @db.Timestamptz(3)
  criadoEm                  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm              DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  placaMae   Hardware @relation("PlacaMaeMemoriaCompatibilidade", fields: [placaMaeId], references: [id], onDelete: Cascade)
  memoriaRam Hardware @relation("MemoriaPlacaMaeCompatibilidade", fields: [memoriaRamId], references: [id], onDelete: Cascade)

  @@unique([placaMaeId, memoriaRamId, revisaoPlacaMae])
  @@index([placaMaeId])
  @@index([memoriaRamId])
  @@map("compatibilidades_memorias_placas_mae")
}

model FonteImportacao {
  id             Int                 @id @default(autoincrement())
  nome           String              @db.VarChar(150)
  fabricante     String              @db.VarChar(100)
  tipo           TipoFonteImportacao
  urlBase        String?             @map("url_base") @db.VarChar(500)
  ativo          Boolean             @default(true)
  ultimaColetaEm DateTime?           @map("ultima_coleta_em") @db.Timestamptz(3)
  criadoEm       DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  importacoes ImportacaoHardware[]

  @@unique([fabricante, nome])
  @@map("fontes_importacao")
}

model ImportacaoHardware {
  id                   Int              @id @default(autoincrement())
  fonteId              Int              @map("fonte_id")
  hardwareId           Int?             @map("hardware_id")
  revisadoPorId        Int?             @map("revisado_por_id")
  identificadorExterno String?          @map("identificador_externo") @db.VarChar(200)
  urlOrigem            String           @map("url_origem") @db.VarChar(500)
  status               StatusImportacao @default(PENDENTE)
  nivelConfianca       Float?           @map("nivel_confianca")
  conteudoBruto        Json?            @map("conteudo_bruto")
  dadosNormalizados    Json?            @map("dados_normalizados")
  hashConteudo         String?          @map("hash_conteudo") @db.VarChar(64)
  erro                 String?          @db.Text
  tentativas           Int              @default(0)
  coletadoEm           DateTime?        @map("coletado_em") @db.Timestamptz(3)
  revisadoEm           DateTime?        @map("revisado_em") @db.Timestamptz(3)
  criadoEm             DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  fonte       FonteImportacao @relation(fields: [fonteId], references: [id], onDelete: Cascade)
  hardware    Hardware?       @relation(fields: [hardwareId], references: [id], onDelete: SetNull)
  revisadoPor Usuario?        @relation("ImportacoesRevisadas", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([fonteId])
  @@index([hardwareId])
  @@index([status])
  @@index([identificadorExterno])
  @@map("importacoes_hardwares")
}

model SlotM2PlacaMae {
  id                      Int                      @id @default(autoincrement())
  especificacaoPlacaMaeId Int                      @map("especificacao_placa_mae_id")
  codigo                  String                   @db.VarChar(50)
  interfacesSuportadas    InterfaceArmazenamento[] @map("interfaces_suportadas")
  chavesSuportadas        ChaveM2[]                @map("chaves_suportadas")
  tamanhosSuportadosMm    Int[]                    @map("tamanhos_suportados_mm")
  geracaoPcieMaxima       Int?                     @map("geracao_pcie_maxima")
  pistasPcie              Int?                     @map("pistas_pcie")
  compartilhaCom          String?                  @map("compartilha_com") @db.VarChar(150)
  observacao              String?                  @db.Text
