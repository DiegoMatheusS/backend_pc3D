  alturaMm                   Float             @map("altura_mm")
  larguraMm                  Float             @map("largura_mm")
  profundidadeMm             Float             @map("profundidade_mm")
  formatosPlacaMaeSuportados FormatoPlacaMae[] @map("formatos_placa_mae_suportados")
  formatosFonteSuportados    FormatoFonte[]    @map("formatos_fonte_suportados")
  comprimentoMaximoFonteMm   Float?            @map("comprimento_maximo_fonte_mm")
  comprimentoMaximoGpuMm     Float?            @map("comprimento_maximo_gpu_mm")
  alturaMaximaGpuMm          Float?            @map("altura_maxima_gpu_mm")
