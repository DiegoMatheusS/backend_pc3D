  sensor        String? @db.VarChar(100)
  dpiMaximo     Int?    @map("dpi_maximo")
  pollingRateHz Int?    @map("polling_rate_hz")
  botoes        Int?
  pesoGramas    Float?  @map("peso_gramas")
  conexao       String? @db.VarChar(100)
  bluetooth     Boolean @default(false)
  wireless      Boolean @default(false)
  cabo          Boolean @default(true)
  rgb           Boolean @default(false)
  mao           String? @db.VarChar(50)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("especificacoes_mouses")
}

model EspecificacaoTeclado {
  id        Int     @id @default(autoincrement())
