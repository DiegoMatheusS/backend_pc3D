  @@index([ofertaId, verificadoEm])
  @@map("historico_precos_ofertas")
}

model CategoriaProduto {
  id           Int                   @id @default(autoincrement())
  nome         String                @db.VarChar(120)
  slug         String                @unique @db.VarChar(140)
  grupo        GrupoCategoriaProduto
  ativo        Boolean               @default(true)
  ordem        Int                   @default(0)
  criadoEm     DateTime              @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produtos Produto[]

  @@index([grupo, ativo, ordem])
  @@map("categorias_produtos")
}

model Produto {
  id               Int         @id @default(autoincrement())
  categoriaId      Int         @map("categoria_id")
  usuarioOrigemId  Int?        @map("usuario_origem_id")
  tipo           TipoProduto @default(GENERICO)
  nome           String      @db.VarChar(200)
  slug           String      @unique @db.VarChar(220)
  marca          String?     @db.VarChar(100)
  modelo         String?     @db.VarChar(150)
  descricao      String?     @db.Text
  mpn            String?     @unique @db.VarChar(150)
  gtin           String?     @unique @db.VarChar(32)
  imagemUrl      String?     @map("imagem_url") @db.VarChar(500)
  imagemHoverUrl String?     @map("imagem_hover_url") @db.VarChar(500)
  metadados      Json?
  publicado      Boolean     @default(false)
  ativo          Boolean     @default(true)
  criadoEm       DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  categoria            CategoriaProduto      @relation(fields: [categoriaId], references: [id])
  usuarioOrigem        Usuario?               @relation("ProdutosUsuarioOrigem", fields: [usuarioOrigemId], references: [id], onDelete: SetNull)
  hardware             Hardware?
  notebook             Notebook?
  build                Build?
  ofertas              Oferta[]
  avaliacoes           Avaliacao[]
  importacoes          ImportacaoProduto[]
  especificacaoMonitor EspecificacaoMonitor?
  especificacaoMouse   EspecificacaoMouse?
  especificacaoTeclado EspecificacaoTeclado?
  especificacaoHeadset EspecificacaoHeadset?
  sugestoesOfertas      SugestaoOferta[]

  @@index([categoriaId, ativo, publicado])
  @@index([usuarioOrigemId])
  @@index([marca])
  @@index([nome])
  @@map("produtos")
}

model EspecificacaoMonitor {
  id                Int     @id @default(autoincrement())
  produtoId         Int     @unique @map("produto_id")
  tamanhoPolegadas  Float?  @map("tamanho_polegadas")
  resolucao         String? @db.VarChar(50)
  taxaAtualizacaoHz Int?    @map("taxa_atualizacao_hz")
  tipoPainel        String? @map("tipo_painel") @db.VarChar(50)
  tempoRespostaMs   Float?  @map("tempo_resposta_ms")
  brilhoNits        Int?    @map("brilho_nits")
  hdr               Boolean @default(false)
  adaptiveSync      Boolean @default(false) @map("adaptive_sync")
  gSync             Boolean @default(false) @map("g_sync")
  freeSync          Boolean @default(false) @map("free_sync")
  hdmi              Int     @default(0)
  displayPort       Int     @default(0) @map("display_port")
  usbC              Int     @default(0) @map("usb_c")
  vesa              String? @db.VarChar(50)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("especificacoes_monitores")
}

model EspecificacaoMouse {
  id            Int     @id @default(autoincrement())
