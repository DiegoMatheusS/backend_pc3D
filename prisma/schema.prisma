  hardwareId                     Int             @unique @map("hardware_id")
  socket                         String          @db.VarChar(50)
  chipset                        String          @db.VarChar(100)
  formato                        FormatoPlacaMae
  revisao                        String?         @db.VarChar(50)
  biosInicial                    String?         @map("bios_inicial") @db.VarChar(50)
  tiposMemoriaSuportados         TipoMemoria[]   @map("tipos_memoria_suportados")
  formatosMemoriaSuportados      FormatoMemoria[] @default([DIMM]) @map("formatos_memoria_suportados")
  frequenciasMemoriaJedecMhz     Int[]           @map("frequencias_memoria_jedec_mhz")
  frequenciasMemoriaOverclockMhz Int[]           @map("frequencias_memoria_overclock_mhz")
  slotsMemoria                   Int             @map("slots_memoria")
  capacidadeMaximaMemoriaGb      Int?            @map("capacidade_maxima_memoria_gb")
  capacidadeMaximaPorSlotGb      Int?            @map("capacidade_maxima_por_slot_gb")
  suportaXmp                     Boolean         @default(false) @map("suporta_xmp")
  suportaExpo                    Boolean         @default(false) @map("suporta_expo")
  suportaEcc                     Boolean         @default(false) @map("suporta_ecc")
  suportaMemoriaRegistrada       Boolean         @default(false) @map("suporta_memoria_registrada")
  saidasVideo                    String[]        @map("saidas_video")
  portasSata                     Int             @default(0) @map("portas_sata")
  versaoPcie                     String?         @map("versao_pcie") @db.VarChar(20)
  wifi                           Boolean         @default(false)
  bluetooth                      Boolean         @default(false)
  ethernet                       String?         @db.VarChar(100)
  biosFlashback                  Boolean         @default(false) @map("bios_flashback")
  biosMinima                     String?         @map("bios_minima") @db.VarChar(50)

  slotsM2  SlotM2PlacaMae[]
  hardware Hardware         @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_placas_mae")
