model Build {
  id                    Int      @id @default(autoincrement())
  produtoId             Int      @unique @map("produto_id")
  categoria             String?  @db.VarChar(100)
  finalidade            String?  @db.VarChar(150)
  resolucaoRecomendada  String?  @map("resolucao_recomendada") @db.VarChar(80)
  consumoEstimadoWatts  Float?   @map("consumo_estimado_watts")
  fonteRecomendadaWatts Int?     @map("fonte_recomendada_watts")
  configuracao3D        Json?    @map("configuracao_3d")
  criadoEm              DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm          DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produto     Produto           @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  componentes BuildComponente[]

  @@map("builds")
}

model BuildComponente {
  id         Int               @id @default(autoincrement())
  buildId    Int               @map("build_id")
  hardwareId Int               @map("hardware_id")
  categoria  CategoriaHardware
  quantidade Int               @default(1)
  posicao    String?           @db.VarChar(100)
  ordem      Int               @default(0)

  build    Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  hardware Hardware @relation(fields: [hardwareId], references: [id])

  @@index([buildId, ordem])
  @@index([hardwareId])
  @@map("build_componentes")
}

model BuildComunidade {
  id                  Int                         @id @default(autoincrement())
  usuarioId           Int                         @map("usuario_id")
  titulo              String                      @db.VarChar(200)
  slug                String                      @unique @db.VarChar(220)
  descricao           String?                     @db.Text
  finalidade          String?                     @db.VarChar(150)
  resolucao           String?                     @db.VarChar(80)
  visibilidade        VisibilidadeBuildComunidade @default(PRIVADA)
  status              StatusBuildComunidade       @default(RASCUNHO)
  precoNaPublicacao   Decimal?                    @map("preco_na_publicacao") @db.Decimal(12, 2)
  consumoNaPublicacao Float?                      @map("consumo_na_publicacao")
  visualizacoes       Int                         @default(0)
  quantidadeCopias    Int                         @default(0) @map("quantidade_copias")
  criadoEm            DateTime                    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime                    @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  publicadoEm         DateTime?                   @map("publicado_em") @db.Timestamptz(3)

  usuario     Usuario                     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  componentes BuildComunidadeComponente[]
  avaliacoes  AvaliacaoBuild[]
  comentarios ComentarioBuild[]

  @@index([status, visibilidade, publicadoEm])
  @@index([usuarioId, status, atualizadoEm])
  @@index([finalidade])
  @@index([resolucao])
  @@map("builds_comunidade")
}

model BuildComunidadeComponente {
  id         Int               @id @default(autoincrement())
  buildId    Int               @map("build_id")
  hardwareId Int?              @map("hardware_id")
  categoria  CategoriaHardware
  nome       String            @db.VarChar(200)
  marca      String?           @db.VarChar(100)
  modelo     String?           @db.VarChar(150)
  imagemUrl        String?           @map("imagem_url") @db.VarChar(500)
  quantidade       Int               @default(1)
  posicao          String?           @db.VarChar(100)
  origem            String?           @db.VarChar(30)
  especificacoes    Json?
  fonteDadosUrl     String?           @map("fonte_dados_url") @db.VarChar(500)
  modelo3dUrl       String?           @map("modelo_3d_url") @db.VarChar(500)

  build    BuildComunidade @relation(fields: [buildId], references: [id], onDelete: Cascade)
  hardware Hardware?       @relation(fields: [hardwareId], references: [id], onDelete: SetNull)

  @@index([buildId])
  @@index([hardwareId])
  @@index([categoria])
  @@map("builds_comunidade_componentes")
}

model AvaliacaoBuild {
  id           Int      @id @default(autoincrement())
  buildId      Int      @map("build_id")
  usuarioId    Int      @map("usuario_id")
  nota         Int
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  build   BuildComunidade @relation(fields: [buildId], references: [id], onDelete: Cascade)
  usuario Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([buildId, usuarioId])
  @@index([buildId, criadoEm])
  @@index([usuarioId])
  @@map("avaliacoes_builds_comunidade")
}

model ComentarioBuild {
  id              Int                   @id @default(autoincrement())
  buildId         Int                   @map("build_id")
  usuarioId       Int                   @map("usuario_id")
  comentarioPaiId Int?                  @map("comentario_pai_id")
  texto           String                @db.VarChar(3000)
  status          StatusComentarioBuild @default(PUBLICADO)
  criadoEm        DateTime              @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  build         BuildComunidade   @relation(fields: [buildId], references: [id], onDelete: Cascade)
  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  comentarioPai ComentarioBuild?  @relation("RespostasComentarioBuild", fields: [comentarioPaiId], references: [id], onDelete: SetNull)
  respostas     ComentarioBuild[] @relation("RespostasComentarioBuild")

  @@index([buildId, status, criadoEm])
  @@index([usuarioId])
  @@index([comentarioPaiId])
  @@map("comentarios_builds_comunidade")
}

model Avaliacao {
  id           Int             @id @default(autoincrement())
  usuarioId    Int             @map("usuario_id")
  produtoId    Int             @map("produto_id")
  nota         Int
  titulo       String?         @db.VarChar(200)
  comentario   String          @db.VarChar(3000)
  status       StatusAvaliacao @default(PUBLICADA)
  criadoEm     DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
  @@index([produtoId, status, criadoEm])
  @@map("avaliacoes")
}

model ImportacaoProduto {
  id                   Int               @id @default(autoincrement())
  produtoId            Int?              @map("produto_id")
  revisadoPorId        Int?              @map("revisado_por_id")
  urlOrigem            String            @map("url_origem") @db.VarChar(500)
  status               StatusImportacao  @default(PENDENTE)
  origemPrincipal      OrigemDadoProduto @default(MANUAL) @map("origem_principal")
  conteudoBruto        Json?             @map("conteudo_bruto")
  dadosNormalizados    Json?             @map("dados_normalizados")
  camposNaoEncontrados String[]          @default([]) @map("campos_nao_encontrados")
  hashConteudo         String?           @map("hash_conteudo") @db.VarChar(64)
  erro                 String?           @db.Text
  coletadoEm           DateTime?         @map("coletado_em") @db.Timestamptz(3)
  revisadoEm           DateTime?         @map("revisado_em") @db.Timestamptz(3)
  criadoEm             DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produto     Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  revisadoPor Usuario? @relation("ImportacoesProdutosRevisadas", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([produtoId])
  @@index([status])
  @@map("importacoes_produtos")
}

model AuditoriaLog {
  id           Int           @id @default(autoincrement())
  usuarioId    Int?          @map("usuario_id")
  acao         AcaoAuditoria
  entidade     String        @db.VarChar(100)
  entidadeId   String?       @map("entidade_id") @db.VarChar(100)
  dadosAntigos Json?         @map("dados_antigos")
  dadosNovos   Json?         @map("dados_novos")
  ip           String?       @db.VarChar(45)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([acao])
  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("auditoria_logs")
}
