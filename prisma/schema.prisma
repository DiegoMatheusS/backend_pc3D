model Usuario {
  id                           Int                  @id @default(autoincrement())
  nome                         String               @db.VarChar(150)
  email                        String               @unique @db.VarChar(255)
  senhaHash                    String               @map("senha_hash") @db.VarChar(255)
  googleSub                    String?              @unique @map("google_sub") @db.VarChar(255)
  papel                        PapelUsuario         @default(USUARIO)
  ativo                        Boolean              @default(true)
  criadoEm                     DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm                 DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  importacoesRevisadas         ImportacaoHardware[] @relation("ImportacoesRevisadas")
  importacoesProdutosRevisadas ImportacaoProduto[]  @relation("ImportacoesProdutosRevisadas")

  sessoes          Sessao[]
  montagens        Montagem[]
  logsAuditoria    AuditoriaLog[]
  avaliacoes       Avaliacao[]
  buildsComunidade BuildComunidade[]
  avaliacoesBuild  AvaliacaoBuild[]
  comentariosBuild              ComentarioBuild[]
  sugestoesOfertas             SugestaoOferta[] @relation("SugestoesOfertasUsuario")
  sugestoesOfertasAnalisadas   SugestaoOferta[] @relation("SugestoesOfertasAnalisadas")
  produtosOrigem               Produto[]        @relation("ProdutosUsuarioOrigem")
  ofertasOrigem                Oferta[]         @relation("OfertasUsuarioOrigem")
  notificacoes                 Notificacao[]
  tokensChatbotCadastro        ChatbotCadastroToken[]

  @@map("usuarios")
}

model Sessao {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadaEm DateTime? @map("revogada_em") @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

model Notificacao {
  id             Int       @id @default(autoincrement())
  usuarioId      Int       @map("usuario_id")
  tipo           String    @db.VarChar(80)
  titulo         String    @db.VarChar(160)
  mensagem       String    @db.Text
  referenciaTipo String?   @map("referencia_tipo") @db.VarChar(80)
  referenciaId   String?   @map("referencia_id") @db.VarChar(100)
  chaveDedupe    String?   @unique @map("chave_dedupe") @db.VarChar(180)
  lida           Boolean   @default(false)
  lidaEm         DateTime? @map("lida_em") @db.Timestamptz(3)
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("notificacoes")
}

model ChatbotCadastroToken {
  id                   Int       @id @default(autoincrement())
  token                String    @unique @db.VarChar(64)
  usuarioId            Int       @map("usuario_id")
  acao                 String    @db.VarChar(40)
  url                  String    @db.Text
  categoriaEsperada    String?   @map("categoria_esperada") @db.VarChar(80)
  resultadoNormalizado Json      @map("resultado_normalizado")
  reconciliacao        Json
  status               String    @default("PENDENTE") @db.VarChar(20)
  resultadoFinal       Json?     @map("resultado_final")
  expiraEm             DateTime  @map("expira_em") @db.Timestamptz(3)
  consumidoEm          DateTime? @map("consumido_em") @db.Timestamptz(3)
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, status, expiraEm])
  @@index([expiraEm])
  @@map("chatbot_cadastro_tokens")
}

model Hardware {
  id                         Int                         @id @default(autoincrement())
  produtoId                  Int?                        @unique @map("produto_id")
  nome                       String                      @db.VarChar(200)
  slug                       String                      @unique @db.VarChar(220)
  categoria                  CategoriaHardware
  marca                      String                      @db.VarChar(100)
  modelo                     String                      @db.VarChar(150)
  descricao                  String?                     @db.Text
  mpn                        String?                     @unique @db.VarChar(150)
  gtin                       String?                     @unique @db.VarChar(32)
  imagemUrl                  String?                     @map("imagem_url") @db.VarChar(500)
  imagemHoverUrl             String?                     @map("imagem_hover_url") @db.VarChar(500)
  especificacoes             Json?
  publicado                  Boolean                     @default(false)
  ativo                      Boolean                     @default(true)
  criadoEm                   DateTime                    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm               DateTime                    @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  especificacaoProcessador   EspecificacaoProcessador?
  especificacaoPlacaMae      EspecificacaoPlacaMae?
  especificacaoMemoriaRam    EspecificacaoMemoriaRam?
  especificacaoGabinete      EspecificacaoGabinete?
  especificacaoFonte         EspecificacaoFonte?
  especificacaoPlacaVideo    EspecificacaoPlacaVideo?
  especificacaoCooler        EspecificacaoCooler?
  especificacaoVentoinha     EspecificacaoVentoinha?
  especificacaoArmazenamento EspecificacaoArmazenamento?
  modelos3D                  Modelo3DHardware[]
  pontosEncaixe              PontoEncaixeHardware[]
  ajustesComoHardwareFilho   AjusteEncaixeHardware[]
  importacoes                ImportacaoHardware[]
  produto                    Produto?                    @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  montagensComoGabinete       Montagem[]                  @relation("MontagemGabinete")
  montagensComoFonte          Montagem[]                  @relation("MontagemFonte")
  montagensComoCooler         Montagem[]                  @relation("MontagemCooler")
  itensMontagem               ItemMontagem[]              @relation("ItensMontagem")
  ventoinhasConfigMontagem    VentoinhaConfigMontagem[]   @relation("VentoinhasConfigMontagem")
  ofertas                     Oferta[]
  buildsComponentes           BuildComponente[]
  buildsComunidadeComponentes BuildComunidadeComponente[]

  compatibilidadesComoPlacaMae CompatibilidadeCpuPlacaMae[] @relation("PlacaMaeCpuCompatibilidade")

  compatibilidadesComoProcessador CompatibilidadeCpuPlacaMae[] @relation("ProcessadorPlacaMaeCompatibilidade")

  compatibilidadesComoPlacaMaeRam CompatibilidadeMemoriaPlacaMae[] @relation("PlacaMaeMemoriaCompatibilidade")

  compatibilidadesComoMemoriaRam CompatibilidadeMemoriaPlacaMae[] @relation("MemoriaPlacaMaeCompatibilidade")

  @@index([categoria])
  @@index([marca])
  @@index([ativo, publicado])
  @@map("hardwares")
}

model EspecificacaoProcessador {
  id                         Int           @id @default(autoincrement())
  hardwareId                 Int           @unique @map("hardware_id")
  socket                     String        @db.VarChar(50)
  familia                    String?       @db.VarChar(100)
  linha                      String?       @db.VarChar(100)
  geracao                    String?       @db.VarChar(100)
  arquitetura                String?       @db.VarChar(100)
  litografiaNm               Float?        @map("litografia_nm")
  nucleos                    Int?
  threads                    Int?
  frequenciaBaseMhz          Int?          @map("frequencia_base_mhz")
  frequenciaTurboMhz         Int?          @map("frequencia_turbo_mhz")
  cacheL2Mb                  Float?        @map("cache_l2_mb")
  cacheL3Mb                  Float?        @map("cache_l3_mb")
  tdpWatts                   Int?          @map("tdp_watts")
  possuiVideoIntegrado       Boolean       @default(false) @map("possui_video_integrado")
  modeloVideoIntegrado       String?       @map("modelo_video_integrado") @db.VarChar(150)
  tiposMemoriaSuportados     TipoMemoria[] @map("tipos_memoria_suportados")
  frequenciaMemoriaMaximaMhz Int?          @map("frequencia_memoria_maxima_mhz")
  capacidadeMemoriaMaximaGb  Int?          @map("capacidade_memoria_maxima_gb")
  canaisMemoria              Int?          @map("canais_memoria")
  suportaEcc                 Boolean       @default(false) @map("suporta_ecc")
  temperaturaMaximaC         Float?        @map("temperatura_maxima_c")
  versaoPcie                 String?       @map("versao_pcie") @db.VarChar(20)
  lanesPcie                  Int?          @map("lanes_pcie")
  coolerIncluso              Boolean       @default(false) @map("cooler_incluso")
  multiplicadorDesbloqueado  Boolean       @default(false) @map("multiplicador_desbloqueado")
  suporteOverclock           Boolean       @default(false) @map("suporte_overclock")
  dataLancamento             DateTime?     @map("data_lancamento") @db.Date

  hardware Hardware @relation(fields: [hardwareId], references: [id], onDelete: Cascade)

  @@map("especificacoes_processadores")
}

